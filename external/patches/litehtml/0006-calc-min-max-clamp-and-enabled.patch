 namespace litehtml
 {
 
+    // calc() and its kin  https://drafts.csswg.org/css-values-4/#calc-syntax
+    // <calc-sum> = <calc-product> [ [ '+' | '-' ] <calc-product> ]*
+    // <calc-product> = <calc-value> [ [ '*' | '/' ] <calc-value> ]*
+    // <calc-value> = <number> | <dimension> | <percentage> | ( <calc-sum> ) | calc() | min() | max() | clamp()
+    namespace
+    {
+        using calc_ptr = std::shared_ptr<css_calc>;
+
+        struct calc_parser
+        {
+            const css_token_vector& tokens;
+            size_t                  i = 0;
+
+            void skip_whitespace()
+            {
+                while(i < tokens.size() && tokens[i].type == WHITESPACE)
+                {
+                    i++;
+                }
+            }
+
+            calc_ptr node(css_calc::op_t op, calc_ptr a, calc_ptr b)
+            {
+                auto n  = std::make_shared<css_calc>();
+                n->op   = op;
+                n->args = {a, b};
+                return n;
+            }
+
+            calc_ptr value()
+            {
+                skip_whitespace();
+                if(i >= tokens.size())
+                {
+                    return nullptr;
+                }
+                const css_token& tok = tokens[i++];
+                auto             n   = std::make_shared<css_calc>();
+                switch(tok.type)
+                {
+                case NUMBER:
+                    n->value = tok.n.number;
+                    return n;
+                case PERCENTAGE:
+                    n->value = tok.n.number;
+                    n->units = css_units_percentage;
+                    return n;
+                case DIMENSION:
+                    {
+                        auto idx = css_values(css_units_strings).value_index(lowcase(tok.unit()));
+                        if(!idx.has_value() || idx.value() == css_units_none || idx.value() == css_units_percentage)
+                        {
+                            return nullptr;
+                        }
+                        n->value = tok.n.number;
+                        n->units = static_cast<css_units>(idx.value());
+                        return n;
+                    }
+                case ROUND_BLOCK:
+                    return parse_calc_function("calc", tok.value);
+                case CV_FUNCTION:
+                    return parse_calc_function(lowcase(tok.name()), tok.value);
+                default:
+                    return nullptr;
+                }
+            }
+
+            calc_ptr product()
+            {
+                calc_ptr left = value();
+                for(;;)
+                {
+                    skip_whitespace();
+                    if(!left || i >= tokens.size() || (tokens[i].type != '*' && tokens[i].type != '/'))
+                    {
+                        return left;
+                    }
+                    auto     op    = tokens[i++].type == '*' ? css_calc::mul : css_calc::div;
+                    calc_ptr right = value();
+                    if(!right)
+                    {
+                        return nullptr;
+                    }
+                    left = node(op, left, right);
+                }
+            }
+
+            calc_ptr sum()
+            {
+                calc_ptr left = product();
+                for(;;)
+                {
+                    skip_whitespace();
+                    if(!left || i >= tokens.size() || (tokens[i].type != '+' && tokens[i].type != '-'))
+                    {
+                        return left;
+                    }
+                    auto     op    = tokens[i++].type == '+' ? css_calc::add : css_calc::sub;
+                    calc_ptr right = product();
+                    if(!right)
+                    {
+                        return nullptr;
+                    }
+                    left = node(op, left, right);
+                }
+            }
+
+            // The arguments up to the end, each a sum, separated by commas
+            bool arguments(std::vector<std::shared_ptr<const css_calc>>& args)
+            {
+                for(;;)
+                {
+                    calc_ptr arg = sum();
+                    if(!arg)
+                    {
+                        return false;
+                    }
+                    args.push_back(arg);
+                    skip_whitespace();
+                    if(i >= tokens.size())
+                    {
+                        return true;
+                    }
+                    if(tokens[i++].type != ',')
+                    {
+                        return false;
+                    }
+                }
+            }
+
+            static calc_ptr parse_calc_function(const std::string& name, const css_token_vector& args)
+            {
+                calc_parser p{args};
+                if(name == "calc")
+                {
+                    calc_ptr n = p.sum();
+                    p.skip_whitespace();
+                    return n && p.i == args.size() ? n : nullptr;
+                }
+                auto n = std::make_shared<css_calc>();
+                n->op  = name == "min" ? css_calc::min : name == "max" ? css_calc::max : css_calc::clamp;
+                if((name != "min" && name != "max" && name != "clamp") || !p.arguments(n->args) ||
+                   (n->op == css_calc::clamp && n->args.size() != 3))
+                {
+                    return nullptr;
+                }
+                return n;
+            }
+        };
+
+        bool is_calc_function(const css_token& token)
+        {
+            if(token.type != CV_FUNCTION)
+            {
+                return false;
+            }
+            std::string name = lowcase(token.name());
+            return name == "calc" || name == "min" || name == "max" || name == "clamp";
+        }
+    } // namespace
+
+    bool css_calc::has_percentage() const
+    {
+        if(op == leaf)
+        {
+            return units == css_units_percentage;
+        }
+        for(const auto& arg : args)
+        {
+            if(arg->has_percentage())
+            {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    // Numbers and lengths told apart for * and /: a length times a number, or divided by one
+    static bool calc_eval(const css_calc& c, const std::function<float(float, css_units)>& leaf, float& result,
+                          bool& number)
+    {
+        if(c.op == css_calc::leaf)
+        {
+            number = c.units == css_units_none;
+            result = number ? c.value : leaf(c.value, c.units);
+            return true;
+        }
+        std::vector<float> v(c.args.size());
+        std::vector<char>  num(c.args.size());
+        for(size_t k = 0; k < c.args.size(); k++)
+        {
+            bool n;
+            if(!calc_eval(*c.args[k], leaf, v[k], n))
+            {
+                return false;
+            }
+            num[k] = n;
+        }
+        switch(c.op)
+        {
+        case css_calc::add:
+        case css_calc::sub:
+            number = num[0] && num[1];
+            result = c.op == css_calc::add ? v[0] + v[1] : v[0] - v[1];
+            return num[0] == num[1];
+        case css_calc::mul:
+            number = num[0] && num[1];
+            result = v[0] * v[1];
+            return num[0] || num[1];
+        case css_calc::div:
+            number = num[0];
+            result = v[1] != 0 ? v[0] / v[1] : 0;
+            return num[1] && v[1] != 0;
+        case css_calc::min:
+        case css_calc::max:
+            number = num[0];
+            result = v[0];
+            for(size_t k = 1; k < v.size(); k++)
+            {
+                if(num[k] != num[0])
+                {
+                    return false;
+                }
+                result = c.op == css_calc::min ? std::min(result, v[k]) : std::max(result, v[k]);
+            }
+            return true;
+        case css_calc::clamp:
+            number = num[0];
+            result = std::max(v[0], std::min(v[1], v[2]));
+            return num[0] == num[1] && num[1] == num[2];
+        default:
+            return false;
+        }
+    }
+
+    bool css_calc::eval(const std::function<float(float, css_units)>& leaf, float& result) const
+    {
+        bool number;
+        return calc_eval(*this, leaf, result, number);
+    }
+
+    std::shared_ptr<const css_calc> css_calc::to_px(const std::function<float(float, css_units)>& leaf) const
+    {
+        auto n = std::make_shared<css_calc>(*this);
+        if(op == css_calc::leaf)
+        {
+            if(units != css_units_none && units != css_units_percentage)
+            {
+                n->value = leaf(value, units);
+                n->units = css_units_px;
+            }
+            return n;
+        }
+        for(auto& arg : n->args)
+        {
+            arg = arg->to_px(leaf);
+        }
+        return n;
+    }
+
+    void css_length::set_calc(std::shared_ptr<const css_calc> calc, css_units units)
+    {
+        m_value         = 0;
+        m_units         = units;
+        m_is_predefined = false;
+        m_calc          = std::move(calc);
+    }
+
     bool css_length::from_token(const css_token& token, int options, css_values keywords)
     {
+        if(is_calc_function(token))
+        {
+            auto calc = calc_parser::parse_calc_function(lowcase(token.name()), token.value);
+            if(!calc)
+            {
+                return false;
+            }
+            float value;
+            bool  number;
+            if(!calc_eval(*calc, [](float v, css_units) { return v; }, value, number))
+            {
+                return false;
+            }
