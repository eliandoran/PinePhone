--- a/src/html_tag.cpp
+++ b/src/html_tag.cpp
@@ -203,10 +203,79 @@ namespace litehtml
         return nullptr;
     }
 
+    namespace
+    {
+        // The tags, classes and ids of the elements above the one being styled, while the
+        // style sheet is applied from the root down: a counting Bloom filter. A selector
+        // needing an ancestor with a key not in it cannot match (one in it may: hashes
+        // collide), which is most of them, found without walking up the tree.
+        struct ancestor_filter
+        {
+            static constexpr int BITS = 12;
+            bool                 active = false;
+            uint16_t             counts[1 << BITS];
+
+            static int slot(int key)
+            {
+                return static_cast<int>((static_cast<uint32_t>(key) * 2654435761u) >> (32 - BITS));
+            }
+            bool may_match(const std::vector<int>& keys) const
+            {
+                for(int key : keys)
+                {
+                    if(!counts[slot(key)])
+                    {
+                        return false;
+                    }
+                }
+                return true;
+            }
+            void add(string_id tag, string_id id, const std::vector<string_id>& classes, int by)
+            {
+                counts[slot(ancestor_key(0, tag))] += by;
+                if(id != empty_id)
+                {
+                    counts[slot(ancestor_key(2, id))] += by;
+                }
+                for(string_id c : classes)
+                {
+                    counts[slot(ancestor_key(1, c))] += by;
+                }
+            }
+        };
+        thread_local ancestor_filter filter;
+    } // namespace
