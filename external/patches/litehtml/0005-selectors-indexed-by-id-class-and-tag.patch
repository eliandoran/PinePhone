     {
         std::sort(m_selectors.begin(), m_selectors.end(),
                   [](const css_selector::ptr& v1, const css_selector::ptr& v2) { return (*v1) < (*v2); });
+
+        m_by_id.clear();
+        m_by_class.clear();
+        m_by_tag.clear();
+        m_any.clear();
+        for(int i = 0; i < static_cast<int>(m_selectors.size()); i++)
+        {
+            // What the compounds before a descendant or child combinator need: they match
+            // ancestors (those before a sibling combinator, a sibling's ancestors: the same)
+            css_selector& sel = *m_selectors[i];
+            sel.m_ancestor_keys.clear();
+            for(const css_selector* s = &sel; s->m_left; s = s->m_left.get())
+            {
+                if(s->m_combinator != combinator_descendant && s->m_combinator != combinator_child)
+                {
+                    continue;
+                }
+                const css_element_selector& left = s->m_left->m_right;
+                if(left.m_tag != star_id)
+                {
+                    sel.m_ancestor_keys.push_back(ancestor_key(0, left.m_tag));
+                }
+                for(const auto& attr : left.m_attrs)
+                {
+                    if(attr.type == select_class || attr.type == select_id)
+                    {
+                        sel.m_ancestor_keys.push_back(ancestor_key(attr.type == select_class ? 1 : 2, attr.name));
+                    }
+                }
+            }
+
+            const css_element_selector&   r   = m_selectors[i]->m_right;
+            const css_attribute_selector* id  = nullptr;
+            const css_attribute_selector* cls = nullptr;
+            for(const auto& attr : r.m_attrs)
+            {
+                if(attr.type == select_id && !id)
+                {
+                    id = &attr;
+                } else if(attr.type == select_class && !cls)
+                {
+                    cls = &attr;
+                }
+            }
+            if(id)
+            {
+                m_by_id[id->name].push_back(i);
+            } else if(cls)
+            {
+                m_by_class[cls->name].push_back(i);
+            } else if(r.m_tag != star_id)
+            {
+                m_by_tag[r.m_tag].push_back(i);
+            } else
+            {
+                m_any.push_back(i);
+            }
+        }
+        m_indexed = m_selectors.size();
+    }
+
+    bool css::candidates(string_id tag, string_id id, const std::vector<string_id>& classes,
+                         std::vector<int>& out) const
+    {
+        out.clear();
+        if(m_indexed != m_selectors.size())
+        {
+            return false;
+        }
+        auto add = [&](const std::unordered_map<int, std::vector<int>>& map, string_id key) {
+            auto it = map.find(key);
+            if(it != map.end())
+            {
+                out.insert(out.end(), it->second.begin(), it->second.end());
+            }
+        };
+        out.insert(out.end(), m_any.begin(), m_any.end());
+        add(m_by_tag, tag);
+        if(id != empty_id)
+        {
+            add(m_by_id, id);
+        }
+        for(string_id c : classes)
+        {
+            add(m_by_class, c);
+        }
+        // Each selector is in one list: only a class written twice repeats some
+        std::sort(out.begin(), out.end());
+        out.erase(std::unique(out.begin(), out.end()), out.end());
+        return true;
     }
 
