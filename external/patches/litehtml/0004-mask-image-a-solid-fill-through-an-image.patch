+    }
+
     for(auto& image : m_bg.m_image)
     {
         switch(image.type)
--- a/src/style.cpp
+++ b/src/style.cpp
@@ -477,6 +477,18 @@ namespace litehtml
             parse_list_style(value, baseurl, important);
             break;
 
+            //  =============================  MASK  =============================
+
+        // One image (the first layer's), -webkit- prefixed as most sites still also write it
+        case _mask_image_:
+        case __webkit_mask_image_:
+            if(std::string url; parse_list_style_image(value[0], url))
