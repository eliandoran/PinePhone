From: PinePhone firmware
Subject: [PATCH] mask-image: a solid fill through an image

mask-image (and -webkit-mask-image) were ignored: icons drawn as a
background color through an SVG mask (Wikipedia's language and edit
icons) showed as squares of that color. The first layer's image is kept
with the background; the color layer is drawn through it by the
container's new draw_mask() (by default the fill as before), the
element's image and gradient layers not at all while it has a mask.
---
--- a/include/litehtml/background.h
+++ b/include/litehtml/background.h
@@ -115,6 +115,8 @@ namespace litehtml
         int_vector         m_repeat;
         int_vector         m_clip;
         int_vector         m_origin;
+        std::string        m_mask; // mask-image: the layers drawn through it (a URL, "" if none)
+        std::string        m_mask_baseurl;
 
         bool is_empty() const
         {
--- a/include/litehtml/document_container.h
+++ b/include/litehtml/document_container.h
@@ -48,6 +48,13 @@ namespace litehtml
         virtual void draw_image(litehtml::uint_ptr hdc, const background_layer& layer, const std::string& url,
                                 const std::string& base_url)                                                        = 0;
         virtual void draw_solid_fill(litehtml::uint_ptr hdc, const background_layer& layer, const web_color& color) = 0;
+        // A solid fill through the mask-image at url (its alpha, over the layer's box: mask-size and
+        // mask-position are not read); the fill alone unless the container overrides it
+        virtual void draw_mask(litehtml::uint_ptr hdc, const background_layer& layer, const std::string& url,
+                               const std::string& base_url, const web_color& color)
+        {
+            draw_solid_fill(hdc, layer, color);
+        }
         virtual void draw_linear_gradient(litehtml::uint_ptr hdc, const background_layer& layer,
                                           const background_layer::linear_gradient& gradient)                        = 0;
         virtual void draw_radial_gradient(litehtml::uint_ptr hdc, const background_layer& layer,
--- a/include/litehtml/string_id.h
+++ b/include/litehtml/string_id.h
@@ -73,6 +73,8 @@ namespace litehtml
 
         _list_style_, _list_style_type_, _list_style_position_, _list_style_image_, _list_style_image_baseurl_,
 
+        _mask_image_, _mask_image_baseurl_, __webkit_mask_image_,
+
         _margin_, _margin_top_, _margin_right_, _margin_bottom_, _margin_left_,
 
         _padding_, _padding_top_, _padding_right_, _padding_bottom_, _padding_left_,
--- a/src/background.cpp
+++ b/src/background.cpp
@@ -703,6 +703,16 @@ namespace litehtml
     void litehtml::background::draw_layer(uint_ptr hdc, int idx, const background_layer& layer,
                                           document_container* container) const
     {
+        // Through a mask: only the color, as icons are (the images and gradients not masked yet)
+        if(!m_mask.empty())
+        {
+            auto color_layer = get_layer_type(idx) == type_color ? get_color_layer(idx) : nullptr;
+            if(color_layer)
+            {
+                container->draw_mask(hdc, layer, m_mask, m_mask_baseurl, color_layer->color);
+            }
+            return;
+        }
         switch(get_layer_type(idx))
         {
         case background::type_color:
