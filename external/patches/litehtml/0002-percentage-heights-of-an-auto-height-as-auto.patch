+// A percentage of a containing block whose height depends on its content: as auto (none for
+// min/max-height), CSS 2.1 10.5. An absolutely positioned box's containing block is laid out
+// before it, so its percentages resolve.
+bool litehtml::render_item::percent_of_auto_height(const css_length& len, const containing_block_context& cb_context) const
+{
+    return !len.is_predefined() && len.units() == css_units_percentage &&
+           cb_context.height.type == containing_block_context::cbc_value_type_auto &&
+           !is_one_of(src_el()->css().get_position(), element_position_absolute, element_position_fixed);
+}
