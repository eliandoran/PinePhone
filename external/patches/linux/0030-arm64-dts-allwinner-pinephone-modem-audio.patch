From: Elian Doran <doran.adoris.elian@gmail.com>
Subject: [PATCH] arm64: dts: allwinner: pinephone: modem audio

The EG25-G's voice goes over PCM to the codec's AIF2, which mainline
does not describe: calls connect, silent both ways. A link like the
Bluetooth one on AIF3: the modem as a gtm601 codec (8 kHz, mono, 16
bits, as the modem is set up: AT+QDAI=1,1,0,1,0,0,1,1, the modem a clock
slave, short frame sync, 256 kHz), the codec clocking it with a 32-bit
slot, and AIF2's pins. The bit clock inverted as on the Bluetooth link
(and in Megi's tree).

---
--- a/arch/arm64/boot/dts/allwinner/sun50i-a64-pinephone.dtsi
+++ b/arch/arm64/boot/dts/allwinner/sun50i-a64-pinephone.dtsi
@@ -57,6 +57,12 @@
 		factory-internal-resistance-micro-ohms = <150000>;
 	};
 
+	/* The modem's voice PCM: 8 kHz, mono, 16 bits (AT+QDAI=1,1,0,1,0,0,1,1) */
+	sound_modem: sound-modem {
+		#sound-dai-cells = <0>;
+		compatible = "option,gtm601";
+	};
+
 	bt_sco_codec: bt-sco-codec {
 		#sound-dai-cells = <1>;
 		compatible = "linux,bt-sco";
@@ -202,7 +208,7 @@
 
 &codec {
 	pinctrl-names = "default";
-	pinctrl-0 = <&aif3_pins>;
+	pinctrl-0 = <&aif2_pins>, <&aif3_pins>;
 	status = "okay";
 };
 
@@ -632,6 +638,24 @@
 			"Headset Microphone", "HBIAS",
 			"MIC2", "Headset Microphone";
 
+	/* The modem on AIF2, clocked by the codec: 256 kHz, a 32-bit slot */
+	simple-audio-card,dai-link@1 {
+		format = "dsp_a";
+		frame-master = <&link1_codec>;
+		bitclock-master = <&link1_codec>;
+		bitclock-inversion;
+
+		link1_cpu: cpu {
+			sound-dai = <&sound_modem>;
+		};
+
+		link1_codec: codec {
+			sound-dai = <&codec 1>;
+			dai-tdm-slot-num = <1>;
+			dai-tdm-slot-width = <32>;
+		};
+	};
+
 	simple-audio-card,dai-link@2 {
 		format = "dsp_a";
 		frame-master = <&link2_codec>;
