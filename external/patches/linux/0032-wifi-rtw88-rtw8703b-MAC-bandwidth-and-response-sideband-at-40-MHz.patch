From: PinePhone firmware
Subject: [PATCH] wifi: rtw88: rtw8703b: MAC bandwidth and response sideband at 40 MHz

rtw_set_channel_mac() programs the newer chips' MAC registers
(REG_DATA_SC, REG_WMAC_TRXPTCL_CTL). The RTL8703B's generation takes the
MAC bandwidth from REG_BWOPMODE and the 20 MHz half that response frames
(ACK, CTS, BlockAck) are sent on from REG_RRSR's RSC bits, as the vendor
driver, rtlwifi (rtl8723be) and rtl8xxxu set them. rtw88 left
BWOPMODE_20MHZ set and RSC at 0 on a 40 MHz channel, with the baseband
in 40 MHz mode.

rtw_phy_rrsr_update() rewrote all of REG_RRSR every 2 s, clearing RSC:
keep those bits.

On a PinePhone (RTL8723CS) at 40 MHz (primary channel 10, secondary
below), phy_info counted no OFDM frame received (ok 0, err 16) and the
connection dropped every few minutes after beacon loss, auth frames
going unanswered for minutes. With both registers set: HT frames
received (MCS7), 596 of 600 pings over 5 minutes, no beacon loss and
no reconnect.

--- a/drivers/net/wireless/realtek/rtw88/phy.c
+++ b/drivers/net/wireless/realtek/rtw88/phy.c
@@ -658,10 +658,13 @@
 static void rtw_phy_rrsr_update(struct rtw_dev *rtwdev)
 {
 	struct rtw_dm_info *dm_info = &rtwdev->dm_info;
+	u32 rsc = rtw_read32(rtwdev, REG_RRSR) & BITS_RRSR_RSC;
 
 	dm_info->rrsr_mask_min = RRSR_RATE_ORDER_MAX;
 	rtw_iterate_stas(rtwdev, rtw_phy_rrsr_mask_min_iter, rtwdev);
-	rtw_write32(rtwdev, REG_RRSR, dm_info->rrsr_val_init & dm_info->rrsr_mask_min);
+	/* the rates only: the response sideband is the channel's */
+	rtw_write32(rtwdev, REG_RRSR,
+		    (dm_info->rrsr_val_init & dm_info->rrsr_mask_min) | rsc);
 }
 
 static void rtw_phy_dpk_track(struct rtw_dev *rtwdev)
--- a/drivers/net/wireless/realtek/rtw88/reg.h
+++ b/drivers/net/wireless/realtek/rtw88/reg.h
@@ -495,6 +495,8 @@
 #define REG_TIMER0_SRC_SEL	0x05B4
 #define BIT_TSFT_SEL_TIMER0	(BIT(4) | BIT(5) | BIT(6))
 
+#define REG_BWOPMODE		0x0603
+#define BIT_BWOPMODE_20MHZ	BIT(2)
 #define REG_TCR			0x0604
 #define BIT_PWRMGT_HWDATA_EN	BIT(7)
 #define BIT_TCR_UPDATE_TIMIE	BIT(5)
--- a/drivers/net/wireless/realtek/rtw88/rtw8703b.c
+++ b/drivers/net/wireless/realtek/rtw88/rtw8703b.c
@@ -865,11 +865,32 @@
 	}
 }
 
+/* rtw_set_channel_mac() programs the newer chips' registers. This
+ * generation takes the MAC bandwidth from REG_BWOPMODE and the 20 MHz
+ * half that response frames (ACK, CTS, BA) use from REG_RRSR, as the
+ * vendor driver, rtlwifi and rtl8xxxu set them.
+ */
+static void rtw8703b_set_channel_mac(struct rtw_dev *rtwdev, u8 bw,
+				     u8 primary_chan_idx)
+{
+	u8 opmode = rtw_read8(rtwdev, REG_BWOPMODE);
+
+	if (bw == RTW_CHANNEL_WIDTH_40) {
+		rtw_write8(rtwdev, REG_BWOPMODE, opmode & ~BIT_BWOPMODE_20MHZ);
+		rtw_write32_mask(rtwdev, REG_RRSR, BITS_RRSR_RSC,
+				 primary_chan_idx == RTW_SC_20_UPPER ? 2 : 1);
+	} else {
+		rtw_write8(rtwdev, REG_BWOPMODE, opmode | BIT_BWOPMODE_20MHZ);
+		rtw_write32_mask(rtwdev, REG_RRSR, BITS_RRSR_RSC, 0);
+	}
+}
+
 static void rtw8703b_set_channel(struct rtw_dev *rtwdev, u8 channel,
 				 u8 bw, u8 primary_chan_idx)
 {
 	rtw8703b_set_channel_rf(rtwdev, channel, bw);
 	rtw_set_channel_mac(rtwdev, channel, bw, primary_chan_idx);
+	rtw8703b_set_channel_mac(rtwdev, bw, primary_chan_idx);
 	rtw8703b_set_channel_bb(rtwdev, channel, bw, primary_chan_idx);
 }
 
