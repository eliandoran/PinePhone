+/** The display whose driver draws direct textures (NULL: none); forgets the ones known */
+void lv_draw_opengles_direct_set_display(lv_display_t * disp);
+lv_display_t * lv_draw_opengles_direct_get_display(void);
+
+/** A widget's texture has new contents: false if it is not drawn directly now */
+bool lv_draw_opengles_direct_refresh(const lv_obj_t * obj, unsigned int texture);
+
+/** The widget is gone */
+void lv_draw_opengles_direct_forget(const lv_obj_t * obj);
+
+/** Whether a texture was refreshed since the last call: the driver has to present again */
+bool lv_draw_opengles_direct_take_wanted(void);
+
+/** Draw the direct textures that show into the bound framebuffer, of the display's size.
+ * @return how many: the display's texture then goes over them, blended */
+uint32_t lv_draw_opengles_direct_render(lv_display_t * disp);
+
+/** Draw them into `texture` (the display's, w x h) where it is transparent, and forget
+ * them: before the driver stops drawing them itself */
