+/* The frame on the surface: direct textures (lv_3dtexture_set_direct()) first, the
+ * display's texture over them */
+static void present(lv_drm_ctx_t * ctx, lv_display_t * disp)
+{
+    GL_CALL(glBindFramebuffer(GL_FRAMEBUFFER, 0));
+    /* The display texture covers the whole surface. Without a clear, tile based
+     * GPUs (Mali) first reload the previous contents of the surface into each tile. */
+    lv_opengles_render_clear();
+    if(ctx->turn.texture) turn_draw(ctx);
+    else {
+        lv_opengles_viewport(0, 0, lv_display_get_original_horizontal_resolution(disp),
+                             lv_display_get_original_vertical_resolution(disp));
+        lv_opengles_display_over(lv_draw_opengles_direct_render(disp) > 0);
+        lv_opengles_texture_render_display(&ctx->texture, disp);
+        lv_opengles_display_over(false);
+    }
+    lv_opengles_egl_update(ctx->egl_ctx);
+    if(mirror.ctx == ctx && !mirror.source) mirror_draw(ctx);
+}
+
 static void flush_cb(lv_display_t * disp, const lv_area_t * area, uint8_t * px_map)
 {
     LV_UNUSED(area);
     LV_UNUSED(px_map);
     if(lv_display_flush_is_last(disp)) {
-        lv_drm_ctx_t * ctx = lv_display_get_driver_data(disp);
-        /* The display texture covers the whole surface. Without a clear, tile based
-         * GPUs (Mali) first reload the previous contents of the surface into each tile. */
-        lv_opengles_render_clear();
-        if(ctx->turn.texture) turn_draw(ctx);
-        else lv_opengles_texture_render_display(&ctx->texture, disp);
-        lv_opengles_egl_update(ctx->egl_ctx);
-        if(mirror.ctx == ctx && !mirror.source) mirror_draw(ctx);
+        lv_draw_opengles_direct_take_wanted(); /* shown by this frame */
+        present(lv_display_get_driver_data(disp), disp);
     }
     lv_display_flush_ready(disp);
 }
 
+/* Direct textures are drawn by present() only: not on a turned display or while it turns
+ * (turn_draw()), nor while it is mirrored (mirror_draw()). To call between frames: when
+ * that changes, everything is rendered again, with or without them in the display's texture. */
+void lv_linux_drm_direct_update(lv_display_t * disp)
+{
+    lv_drm_ctx_t * ctx = lv_display_get_driver_data(disp);
+    if(ctx == NULL) return;
+    bool allowed = lv_display_get_rotation(disp) == LV_DISPLAY_ROTATION_0 && !ctx->turn.texture && mirror.ctx != ctx;
+    lv_display_t * now = lv_draw_opengles_direct_get_display();
+    if(allowed == (now == disp) || (now != NULL && now != disp)) return;
+    if(!allowed) {
+        lv_draw_opengles_direct_resolve(disp, ctx->texture.texture_id, lv_display_get_horizontal_resolution(disp),
+                                        lv_display_get_vertical_resolution(disp));
+    }
+    lv_draw_opengles_direct_set_display(allowed ? disp : NULL);
+    lv_area_t all = { 0, 0, lv_display_get_horizontal_resolution(disp) - 1, lv_display_get_vertical_resolution(disp) - 1 };
+    lv_inv_area(disp, &all);
+}
+
+/* A direct texture has new contents and LVGL rendered nothing since: the frame again with
+ * it, nothing rendered. To call after LVGL's refresh; false if there was nothing to show. */
+bool lv_linux_drm_present(lv_display_t * disp)
+{
+    lv_drm_ctx_t * ctx = lv_display_get_driver_data(disp);
+    if(ctx == NULL || lv_draw_opengles_direct_get_display() != disp) return false;
+    if(!lv_draw_opengles_direct_take_wanted()) return false;
+    present(ctx, disp);
+    return true;
+}
