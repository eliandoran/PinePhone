+/**
+ * Let the display's driver draw the texture itself, under what LVGL rendered (which gets
+ * a transparent hole where the widget shows), instead of LVGL drawing it into the display's
+ * texture and the driver that to the screen: for a large texture that changes often (a
+ * video, a web page), one pass less on every frame and none of LVGL's for a new one
+ * (lv_3dtexture_refresh()). Where the driver cannot (no support, an opacity, a layer, a
+ * turned display), it is drawn as any other.
+ * @param obj      the 3dtexture widget
+ * @param direct   true to draw it directly
+ */
+void lv_3dtexture_set_direct(lv_obj_t * obj, bool direct);
+
+/**
+ * The texture has new contents (same id, same size): show them. A directly drawn texture
+ * (lv_3dtexture_set_direct()) is presented again without LVGL rendering anything, any other
+ * is invalidated.
+ * @param obj      the 3dtexture widget
+ */
+void lv_3dtexture_refresh(lv_obj_t * obj);
+
