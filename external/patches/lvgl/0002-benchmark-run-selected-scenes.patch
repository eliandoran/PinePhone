From: PinePhone firmware
Subject: [PATCH] demos: benchmark: run selected scenes

lv_demo_benchmark_set_scenes() limits the run to the named scenes, to
measure or profile the slow ones without waiting for the others.
---
--- a/demos/benchmark/lv_demo_benchmark.h
+++ b/demos/benchmark/lv_demo_benchmark.h
@@ -109,6 +109,12 @@
  */
 void lv_demo_benchmark_set_end_cb(lv_demo_benchmark_on_end_cb_t cb);
 
+/*
+ * Run only some scenes. Call before `lv_demo_benchmark()`.
+ * @param names     NULL terminated list of scene names, NULL to run all scenes
+ */
+void lv_demo_benchmark_set_scenes(const char * const * names);
+
 
 /*
  * Display and log the summary
--- a/demos/benchmark/lv_demo_benchmark.c
+++ b/demos/benchmark/lv_demo_benchmark.c
@@ -480,6 +480,19 @@
 static uint32_t scene_act;
 static uint32_t rnd_act;
 static lv_demo_benchmark_on_end_cb_t on_demo_end_cb;
+static const char * const * selected_scenes;
+
+/* First selected scene from `scene` on; the end marker is always selected */
+static uint32_t next_selected_scene(uint32_t scene)
+{
+    for(; scenes[scene].create_cb; scene++) {
+        if(selected_scenes == NULL) return scene;
+        for(const char * const * name = selected_scenes; *name; name++) {
+            if(lv_strcmp(*name, scenes[scene].name) == 0) return scene;
+        }
+    }
+    return scene;
+}
 
 /**********************
  *      MACROS
@@ -491,7 +504,7 @@
 
 void lv_demo_benchmark(void)
 {
-    scene_act = 0;
+    scene_act = next_selected_scene(0);
 
     lv_obj_t * scr = lv_screen_active();
     lv_obj_remove_style_all(scr);
@@ -511,7 +524,7 @@
     load_scene(scr, scene_act);
 
     /* store the active screen so that we can re-use it for the next scenes*/
-    lv_timer_create(next_scene_timer_cb, scenes[0].scene_time, scr);
+    lv_timer_create(next_scene_timer_cb, scenes[scene_act].scene_time, scr);
 
 #if LV_USE_PERF_MONITOR
     lv_display_t * disp = lv_display_get_default();
@@ -529,6 +542,11 @@
     on_demo_end_cb = cb;
 }
 
+void lv_demo_benchmark_set_scenes(const char * const * names)
+{
+    selected_scenes = names;
+}
+
 void lv_demo_benchmark_summary_display(const lv_demo_benchmark_summary_t * summary)
 {
     LV_ASSERT_NULL(summary)
@@ -650,7 +668,8 @@
 
 static void next_scene_timer_cb(lv_timer_t * timer)
 {
-    scene_act++;
+    /* Already at the end marker if no scene was selected */
+    if(scenes[scene_act].create_cb) scene_act = next_selected_scene(scene_act + 1);
     lv_obj_t * scr = lv_timer_get_user_data(timer);
 
     load_scene(scr, scene_act);
