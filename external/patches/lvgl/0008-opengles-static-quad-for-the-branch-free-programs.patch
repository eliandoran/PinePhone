+    if(quad_vertex_array) GL_CALL(glDeleteVertexArrays(1, &quad_vertex_array));
+    if(quad_vertex_buffer) GL_CALL(glDeleteBuffers(1, &quad_vertex_buffer));
+    quad_vertex_array = 0;
+    quad_vertex_buffer = 0;
 }
 
