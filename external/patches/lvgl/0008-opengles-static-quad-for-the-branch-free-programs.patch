+
+static void lv_opengles_quad_draw(void)
+{
+    if(quad_vertex_array == 0) {
+        /*Same corners as the general vertex buffer, texture coordinates 0 to 1*/
+        static const float quad[16] = {
+            -1.f,  1.f, 0.f, 1.f,
+            1.f,  1.f, 1.f, 1.f,
+            1.f, -1.f, 1.f, 0.f,
+            -1.f, -1.f, 0.f, 0.f
+        };
+        GL_CALL(glGenVertexArrays(1, &quad_vertex_array));
+        GL_CALL(glBindVertexArray(quad_vertex_array));
+        GL_CALL(glGenBuffers(1, &quad_vertex_buffer));
+        GL_CALL(glBindBuffer(GL_ARRAY_BUFFER, quad_vertex_buffer));
+        GL_CALL(glBufferData(GL_ARRAY_BUFFER, sizeof(quad), quad, GL_STATIC_DRAW));
+        for(unsigned int i = 0; i < 2; i++) {
+            GL_CALL(glEnableVertexAttribArray(i));
+            GL_CALL(glVertexAttribPointer(i, 2, GL_FLOAT, GL_FALSE, 16, (const void *)(intptr_t)(i * 2 * 4)));
+        }
+    }
+    else {
+        GL_CALL(glBindVertexArray(quad_vertex_array));
+    }
+    GL_CALL(glDrawArrays(GL_TRIANGLE_FAN, 0, 4));
 }
 
