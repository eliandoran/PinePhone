 }
 
+static unsigned int display_shader_compile(unsigned int type, const char * defines, const char * source)
+{
+    const char * sources[] = { "#version 100\n", defines, source };
+    unsigned int shader;
+    int compiled = 0;
+
+    GL_CALL(shader = glCreateShader(type));
+    GL_CALL(glShaderSource(shader, 3, sources, NULL));
+    GL_CALL(glCompileShader(shader));
+    GL_CALL(glGetShaderiv(shader, GL_COMPILE_STATUS, &compiled));
+    if(!compiled) {
+        GL_CALL(glDeleteShader(shader));
+        return 0;
+    }
+    return shader;
+}
+
+/*Same output as the general shader with u_Opa = 1 and u_IsFill = 0, without branches*/
+static unsigned int lv_opengles_display_program_get(bool rb_swap, bool premultiplied)
+{
+    static const char * vertex_source =
+        "attribute vec4 position;\n"
+        "attribute vec2 texCoord;\n"
+        "varying vec2 v_TexCoord;\n"
+        "uniform mat3 u_VertexTransform;\n"
+        "void main()\n"
+        "{\n"
+        "    gl_Position = vec4((u_VertexTransform * vec3(position.xy, 1.0)).xy, position.zw);\n"
+        "    v_TexCoord = texCoord;\n"
+        "}\n";
+    static const char * fragment_source =
+        "precision lowp float;\n"
+        "varying vec2 v_TexCoord;\n"
+        "uniform sampler2D u_Texture;\n"
+        "void main()\n"
+        "{\n"
+        "    vec4 c = texture2D(u_Texture, v_TexCoord);\n"
+        "#ifndef PREMULTIPLIED\n"
+        "    c.rgb *= c.a;\n"
+        "#endif\n"
+        "#ifdef SWAP_RB\n"
+        "    gl_FragColor = c.bgra;\n"
+        "#else\n"
+        "    gl_FragColor = c;\n"
+        "#endif\n"
+        "}\n";
+
+    const unsigned int idx = (rb_swap ? 1 : 0) | (premultiplied ? 2 : 0);
+    if(display_program_tried[idx]) return display_program[idx];
+    display_program_tried[idx] = true;
+
+    char defines[64];
+    lv_snprintf(defines, sizeof(defines), "%s%s", rb_swap ? "#define SWAP_RB\n" : "",
+                premultiplied ? "#define PREMULTIPLIED\n" : "");
+
+    unsigned int vertex = display_shader_compile(GL_VERTEX_SHADER, "", vertex_source);
+    unsigned int fragment = display_shader_compile(GL_FRAGMENT_SHADER, defines, fragment_source);
+    unsigned int program = 0;
+    if(vertex && fragment) {
+        int linked = 0;
+        GL_CALL(program = glCreateProgram());
+        GL_CALL(glAttachShader(program, vertex));
+        GL_CALL(glAttachShader(program, fragment));
+        /*Same attribute indices as the vertex array (lv_opengles_vertex_array_add_buffer)*/
+        GL_CALL(glBindAttribLocation(program, 0, "position"));
+        GL_CALL(glBindAttribLocation(program, 1, "texCoord"));
+        GL_CALL(glLinkProgram(program));
+        GL_CALL(glGetProgramiv(program, GL_LINK_STATUS, &linked));
+        if(!linked) {
+            GL_CALL(glDeleteProgram(program));
+            program = 0;
+        }
+    }
+    if(vertex) GL_CALL(glDeleteShader(vertex));
+    if(fragment) GL_CALL(glDeleteShader(fragment));
+
+    if(program == 0) LV_LOG_WARN("Display shader failed, using the general shader");
+    display_program[idx] = program;
+    return program;
+}
+
+static void lv_opengles_display_programs_deinit(void)
+{
+    for(size_t i = 0; i < 4; i++) {
+        if(display_program[i]) GL_CALL(glDeleteProgram(display_program[i]));
+        display_program[i] = 0;
+        display_program_tried[i] = false;
+    }
+}
+
 static int lv_opengles_shader_get_uniform_location(const char * name)
 {
     int id = -1;
