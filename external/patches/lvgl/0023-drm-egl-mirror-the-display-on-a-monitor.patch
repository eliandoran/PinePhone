+/*
+ * Mirroring (see `mirror`): the display texture upright on the monitor, as large as
+ * it fits: a display turned to landscape fills a landscape monitor.
+ */
+
+static void mirror_retry_cb(lv_timer_t * t)
+{
+    lv_timer_pause(t);
+    if(!mirror.ctx) return;
+    lv_area_t a = { 0, 0, 0, 0 };
+    lv_inv_area(mirror.source ? mirror.source : mirror.ctx->display, &a);
+}
+
+/* The monitor's own display rendered: on the monitor */
+static void mirror_source_rendered_cb(lv_event_t * e)
+{
+    LV_UNUSED(e);
+    if(mirror.ctx && mirror.source) mirror_draw(mirror.ctx);
+}
+
+static void mirror_draw(lv_drm_ctx_t * ctx)
+{
+    if(mirror.bo_flipped) drm_do_page_flip(ctx, 0);
+    if(mirror.bo_flipped || !gbm_surface_has_free_buffers(mirror.gbm_surface)) {
+        /* Still showing the frame before: this one again in a few ms (not now: drawing) */
+        if(!mirror.retry) mirror.retry = lv_timer_create(mirror_retry_cb, 4, NULL);
+        else lv_timer_reset(mirror.retry);
+        lv_timer_resume(mirror.retry);
+        return;
+    }
+
+    lv_opengles_egl_t * egl = ctx->egl_ctx;
+    if(!eglMakeCurrent(egl->egl_display, mirror.egl_surface, mirror.egl_surface, egl->egl_context)) {
+        LV_LOG_WARN("Mirroring: cannot draw on the monitor's surface (%#x)", eglGetError());
+        mirror_stop();
+        return;
+    }
+    /* On the surface itself, not a texture LVGL rendered into last (the monitor's display) */
+    GL_CALL(glBindFramebuffer(GL_FRAMEBUFFER, 0));
+    float w = mirror.mode.hdisplay, h = mirror.mode.vdisplay;
+    float clear[4];
+    GL_CALL(glGetFloatv(GL_COLOR_CLEAR_VALUE, clear));
+    GL_CALL(glClearColor(0.f, 0.f, 0.f, 1.f));
+    lv_opengles_viewport(0, 0, (int32_t)w, (int32_t)h);
+    lv_opengles_render_clear();
+    GL_CALL(glClearColor(clear[0], clear[1], clear[2], clear[3]));
+    /* While turning: the frame before the turn, the new one is not drawn yet */
+    bool turning = ctx->turn.texture != 0;
+    unsigned int texture = ctx->texture.texture_id ? ctx->texture.texture_id : ctx->turn.texture;
+    lv_display_rotation_t r = ctx->texture.texture_id ? ctx->turn.rotation : ctx->turn.from;
+    if(mirror.source && (ctx->turn.program || turn_program_init(ctx))) {
+        /* The monitor's own display, at its size */
+        unsigned int source = lv_opengles_texture_get_texture_id(mirror.source);
+        float sw = lv_display_get_horizontal_resolution(mirror.source);
+        float sh = lv_display_get_vertical_resolution(mirror.source);
+        GL_CALL(glActiveTexture(GL_TEXTURE0));
+        GL_CALL(glUseProgram(ctx->turn.program));
+        GL_CALL(glBindVertexArray(ctx->turn.vertex_array));
+        GL_CALL(glDisable(GL_BLEND));
+        draw_texture(ctx, source, sw, sh, NULL, 0.f, LV_MIN(w / sw, h / sh), 1.f, w, h);
+    }
+    else if(texture && (ctx->turn.program || turn_program_init(ctx))) {
+        float tw, th;
+        turn_size(ctx, r, &tw, &th);
+        /* The area asked for, within the texture (not while turning: of the new orientation) */
+        lv_area_t area = { 0, 0, (int32_t)tw - 1, (int32_t)th - 1 };
+        bool cropped = mirror.has_area && !turning && lv_area_intersect(&area, &area, &mirror.area);
+        if(cropped) {
+            tw = (float)lv_area_get_width(&area);
+            th = (float)lv_area_get_height(&area);
+        }
+        GL_CALL(glActiveTexture(GL_TEXTURE0));
+        GL_CALL(glUseProgram(ctx->turn.program));
+        GL_CALL(glBindVertexArray(ctx->turn.vertex_array));
+        GL_CALL(glDisable(GL_BLEND));
+        turn_texture_filter(texture, GL_LINEAR);
+        turn_draw_texture(ctx, texture, r, cropped ? &area : NULL, 0.f, LV_MIN(w / tw, h / th), 1.f, w, h);
+        turn_texture_filter(texture, turning ? GL_LINEAR : GL_NEAREST);
+    }
+    eglSwapBuffers(egl->egl_display, mirror.egl_surface);
+    eglMakeCurrent(egl->egl_display, egl->egl_surface, egl->egl_surface, egl->egl_context);
+    lv_opengles_viewport(0, 0, lv_display_get_original_horizontal_resolution(ctx->display),
+                         lv_display_get_original_vertical_resolution(ctx->display));
+
+    struct gbm_bo * bo = gbm_surface_lock_front_buffer(mirror.gbm_surface);
+    drm_fb_state_t * fb = bo ? drm_fb_state_create(ctx, bo) : NULL;
+    if(!fb) {
+        LV_LOG_WARN("Mirroring: no buffer for the monitor");
+        if(bo) gbm_surface_release_buffer(mirror.gbm_surface, bo);
+        return;
+    }
+    if(!mirror.crtc_isset) {
+        if(drmModeSetCrtc(ctx->fd, mirror.crtc_id, fb->fb_id, 0, 0, &mirror.connector_id, 1, &mirror.mode) < 0) {
+            LV_LOG_WARN("Mirroring: cannot set the monitor's mode");
+            gbm_surface_release_buffer(mirror.gbm_surface, bo);
+            mirror_stop();
+            return;
+        }
+        mirror.crtc_isset = true;
+        mirror.frames++;
+        if(mirror.bo_presented) gbm_surface_release_buffer(mirror.gbm_surface, mirror.bo_presented);
+        mirror.bo_presented = bo;
+        return;
+    }
+    if(drmModePageFlip(ctx->fd, mirror.crtc_id, fb->fb_id, DRM_MODE_PAGE_FLIP_EVENT, &mirror) < 0) {
+        gbm_surface_release_buffer(mirror.gbm_surface, bo);
+        return;
+    }
+    mirror.bo_flipped = bo;
+}
+
+static void mirror_on_page_flip(void)
+{
+    if(mirror.bo_presented) gbm_surface_release_buffer(mirror.gbm_surface, mirror.bo_presented);
+    mirror.bo_presented = mirror.bo_flipped;
+    mirror.bo_flipped = NULL;
+    mirror.frames++;
+}
+
+static void mirror_stop(void)
+{
+    lv_drm_ctx_t * ctx = mirror.ctx;
+    if(!ctx) return;
+    while(mirror.bo_flipped && drm_do_page_flip(ctx, 100) > 0)
+        continue;
+    mirror.ctx = NULL;
+    if(mirror.retry) lv_timer_pause(mirror.retry);
+    if(mirror.crtc_isset) drmModeSetCrtc(ctx->fd, mirror.crtc_id, 0, 0, 0, NULL, 0, NULL);
+    mirror.crtc_isset = false;
+    if(mirror.bo_flipped) gbm_surface_release_buffer(mirror.gbm_surface, mirror.bo_flipped);
+    if(mirror.bo_presented) gbm_surface_release_buffer(mirror.gbm_surface, mirror.bo_presented);
+    mirror.bo_flipped = mirror.bo_presented = NULL;
+    eglDestroySurface(ctx->egl_ctx->egl_display, mirror.egl_surface);
+    gbm_surface_destroy(mirror.gbm_surface);
+    mirror.egl_surface = EGL_NO_SURFACE;
+    mirror.gbm_surface = NULL;
+}
+
+static bool connector_is_monitor(uint32_t type)
+{
+    return type == DRM_MODE_CONNECTOR_HDMIA || type == DRM_MODE_CONNECTOR_HDMIB ||
+           type == DRM_MODE_CONNECTOR_DisplayPort || type == DRM_MODE_CONNECTOR_DVII ||
+           type == DRM_MODE_CONNECTOR_DVID || type == DRM_MODE_CONNECTOR_DVIA ||
+           type == DRM_MODE_CONNECTOR_VGA;
+}
+
+static bool mirror_start(lv_drm_ctx_t * ctx, uint32_t connector_id)
+{
+    drmModeConnector * connector = drmModeGetConnector(ctx->fd, connector_id); /* probes: the EDID */
+    if(!connector) return false;
+    drmModeModeInfo * mode = NULL;
+    uint32_t best_area = 0;
+    for(int i = 0; i < connector->count_modes; i++) {
+        drmModeModeInfo * m = &connector->modes[i];
+        if(m->type & DRM_MODE_TYPE_PREFERRED) {
+            mode = m;
+            break;
+        }
+        if((uint32_t)m->hdisplay * m->vdisplay > best_area) {
+            best_area = (uint32_t)m->hdisplay * m->vdisplay;
+            mode = m;
+        }
+    }
+    uint32_t crtc_id = 0;
+    for(int i = 0; i < connector->count_encoders && !crtc_id; i++) {
+        drmModeEncoder * encoder = drmModeGetEncoder(ctx->fd, connector->encoders[i]);
+        if(!encoder) continue;
+        for(int j = 0; j < ctx->drm_resources->count_crtcs && !crtc_id; j++)
+            if((encoder->possible_crtcs & (1u << j)) && ctx->drm_resources->crtcs[j] != ctx->drm_encoder->crtc_id)
+                crtc_id = ctx->drm_resources->crtcs[j];
+        drmModeFreeEncoder(encoder);
+    }
+    if(!mode || !crtc_id) {
+        LV_LOG_WARN("Mirroring: the monitor has %s", mode ? "no CRTC free" : "no mode");
+        drmModeFreeConnector(connector);
+        return false;
+    }
+    mirror.mode = *mode;
+    drmModeFreeConnector(connector);
+
+    lv_opengles_egl_t * egl = ctx->egl_ctx;
+    EGLint format = 0;
+    eglGetConfigAttrib(egl->egl_display, egl->egl_config, EGL_NATIVE_VISUAL_ID, &format);
+    mirror.gbm_surface = gbm_surface_create(ctx->gbm_dev, mirror.mode.hdisplay, mirror.mode.vdisplay, (uint32_t)format,
+                                            GBM_BO_USE_SCANOUT | GBM_BO_USE_RENDERING);
+    if(!mirror.gbm_surface) {
+        LV_LOG_WARN("Mirroring: no GBM surface");
+        return false;
+    }
+    mirror.egl_surface = eglCreateWindowSurface(egl->egl_display, egl->egl_config,
+                                                (EGLNativeWindowType)mirror.gbm_surface, NULL);
+    if(mirror.egl_surface == EGL_NO_SURFACE) {
+        LV_LOG_WARN("Mirroring: no EGL surface (%#x)", eglGetError());
+        gbm_surface_destroy(mirror.gbm_surface);
+        mirror.gbm_surface = NULL;
+        return false;
+    }
+    mirror.crtc_id = crtc_id;
+    mirror.crtc_isset = false;
+    mirror.ctx = ctx;
+    lv_obj_invalidate(lv_display_get_screen_active(ctx->display));
+    return true;
+}
+
+/*
+ * Not in a header (a changed LVGL header retires phone-ui's plugins): its user
+ * declares them.
+ *
+ * Mirrors the display on the first monitor connected, or stops when it went: to call
+ * now and then (it reads the connectors' state, cheap; an EDID only once connected).
+ * 1: mirroring started (`w` x `h` at `hz` on the monitor), -1: stopped, 0: as before.
+ */
+int lv_linux_drm_mirror_update(lv_display_t * disp, int32_t * w, int32_t * h, uint32_t * hz)
+{
+    lv_drm_ctx_t * ctx = lv_display_get_driver_data(disp);
+    if(!ctx || !ctx->drm_resources) return 0;
+    uint32_t found = 0;
+    for(int i = 0; i < ctx->drm_resources->count_connectors && !found; i++) {
+        uint32_t id = ctx->drm_resources->connectors[i];
+        if(id == ctx->drm_connector->connector_id) continue;
+        drmModeConnector * c = drmModeGetConnectorCurrent(ctx->fd, id);
+        if(!c) continue;
+        if(connector_is_monitor(c->connector_type) && c->connection == DRM_MODE_CONNECTED) found = id;
+        drmModeFreeConnector(c);
+    }
+    if(found == mirror.connector_id) return 0;
+    bool was = mirror.ctx != NULL;
+    mirror_stop();
+    mirror.connector_id = found;
+    if(found && mirror_start(ctx, found)) {
+        *w = mirror.mode.hdisplay;
+        *h = mirror.mode.vdisplay;
+        *hz = mirror.mode.vrefresh;
+        return 1;
+    }
+    return was ? -1 : 0;
+}
+
+/* The monitor shows only `area` of the display (in its coordinates, as turned), as large
+ * as it fits; NULL: all of it. Taken for each frame drawn from then on. */
+void lv_linux_drm_mirror_area(lv_display_t * disp, const lv_area_t * area)
+{
+    LV_UNUSED(disp);
+    mirror.has_area = area != NULL;
+    if(area) mirror.area = *area;
+}
+
+/* The monitor shows `source` instead, an OpenGL ES texture display (lv_opengles_texture_create())
+ * of its own, each frame it renders; NULL: the display again. Set to NULL before `source`
+ * is deleted. */
+void lv_linux_drm_mirror_source(lv_display_t * disp, lv_display_t * source)
+{
+    LV_UNUSED(disp);
+    if(source == mirror.source) return;
+    if(mirror.source) lv_display_remove_event_cb_with_user_data(mirror.source, mirror_source_rendered_cb, NULL);
+    mirror.source = source;
+    if(source) {
+        lv_display_add_event_cb(source, mirror_source_rendered_cb, LV_EVENT_RENDER_READY, NULL);
+        lv_obj_invalidate(lv_display_get_screen_active(source));
+    }
+    /* Back to the display: its next frame is drawn there (called as one starts, main.c) */
+}
+
+/* How many frames the monitor showed so far (page flips completed, seen when the next
+ * frame is drawn or the display waits for its own): for a frame rate */
+uint32_t lv_linux_drm_mirror_frames(lv_display_t * disp)
+{
+    LV_UNUSED(disp);
+    return mirror.frames;
+}
+
+/* Stops mirroring, before the DRM device goes to another program: the next update starts again */
+void lv_linux_drm_mirror_stop(lv_display_t * disp)
+{
+    LV_UNUSED(disp);
+    mirror_stop();
+    mirror.connector_id = 0;
+}
