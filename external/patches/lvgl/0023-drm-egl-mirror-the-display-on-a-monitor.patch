+
+/* As turn_draw_texture(), a texture of `tw` x `th` */
+static void draw_texture(lv_drm_ctx_t * ctx, unsigned int texture, float tw, float th,
+                         const lv_area_t * area, float angle, float scale, float opa, float vw, float vh)
 {
     float w, h;
