package/Makefile.in: PERL expanded once

Exported and recursively expanded, PERL ran `which perl` again each time make
made a child's environment: for every $(shell ...) while parsing (64 in a pass
here), 1.25 s of the 4.9 s Buildroot took to read its makefiles.

--- a/package/Makefile.in
+++ b/package/Makefile.in
@@ -276,7 +276,7 @@
 # the path to the system perl, before a host-perl built by Buildroot
 # might get installed into $(HOST_DIR)/bin and therefore appears
 # in our PATH. This system perl will be used as INTLTOOL_PERL.
-export PERL=$(shell which perl)
+export PERL := $(shell which perl)
 
 # host-intltool needs libxml-parser-perl, which Buildroot installs in
 # $(HOST_DIR)/lib/perl, so we must make sure that the system perl
