BR2_aarch64=y
BR2_cortex_a53=y
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN_AARCH64_GLIBC_STABLE=y
BR2_DOWNLOAD_FORCE_CHECK_HASHES=y
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_PINEPHONE_PATH)/patches"
BR2_TARGET_GENERIC_HOSTNAME="pinephone"
BR2_TARGET_GENERIC_ISSUE="PinePhone"
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_MDEV=y
# BR2_TARGET_GENERIC_GETTY is not set
# BR2_TARGET_GENERIC_REMOUNT_ROOTFS_RW is not set
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_PINEPHONE_PATH)/board/pinephone/rootfs-overlay"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_PINEPHONE_PATH)/board/pinephone/post-image.sh"
BR2_ROOTFS_POST_SCRIPT_ARGS="-c $(BR2_EXTERNAL_PINEPHONE_PATH)/board/pinephone/genimage.cfg"
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_LATEST_VERSION=y
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(BR2_EXTERNAL_PINEPHONE_PATH)/board/pinephone/linux.defconfig"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_PINEPHONE_PATH)/board/pinephone/linux.fragment"
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_INTREE_DTS_NAME="allwinner/sun50i-a64-pinephone-1.0 allwinner/sun50i-a64-pinephone-1.1 allwinner/sun50i-a64-pinephone-1.2"
BR2_LINUX_KERNEL_DTB_KEEP_DIRNAME=y
BR2_LINUX_KERNEL_INSTALL_TARGET=y
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_LABEL="PP_ROOT"
BR2_TARGET_ROOTFS_EXT2_SIZE="480M"
BR2_TARGET_ROOTFS_EXT2_INODES=8192
BR2_TARGET_ROOTFS_EXT2_RESBLKS=0
BR2_TARGET_ROOTFS_EXT2_MKFS_OPTIONS="-O ^64bit,^has_journal -b 4096"
# BR2_TARGET_ROOTFS_TAR is not set
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_PINEPHONE_PATH)/board/pinephone/post-build.sh"
BR2_ROOTFS_POST_FAKEROOT_SCRIPT="$(BR2_EXTERNAL_PINEPHONE_PATH)/board/pinephone/post-fakeroot.sh"
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_PINEPHONE_PATH)/board/pinephone/busybox.fragment"
BR2_PACKAGE_DROPBEAR=y
BR2_PACKAGE_E2FSPROGS=y
BR2_PACKAGE_UTIL_LINUX=y
BR2_PACKAGE_UTIL_LINUX_BINARIES=y
BR2_PACKAGE_UTIL_LINUX_PARTX=y
BR2_PACKAGE_LVGL=y
BR2_PACKAGE_PHONE_UI=y
# Camera pipeline tools (media-ctl, v4l2-ctl), development; post-build.sh drops the
# other v4l-utils tools
BR2_PACKAGE_LIBV4L=y
BR2_PACKAGE_LIBV4L_UTILS=y
# Rear camera autofocus firmware
BR2_PACKAGE_OV5640_FIRMWARE=y
# Wi-Fi firmware (RTL8723CS, rtw88's rtw8703b); post-build.sh drops the other chips'
BR2_PACKAGE_LINUX_FIRMWARE=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_RTW88=y
# Wi-Fi: wpa_supplicant (S15wifi), driven through its control socket (libwpa_client
# for phone-ui, wpa_cli by hand); iw for debugging
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_WPA3=y
BR2_PACKAGE_WPA_SUPPLICANT_CLI=y
BR2_PACKAGE_WPA_SUPPLICANT_WPA_CLIENT_SO=y
BR2_PACKAGE_IW=y
# Regulatory database: no country set, cfg80211 follows the access point's
BR2_PACKAGE_WIRELESS_REGDB=y
# GPU: Mali-400 MP2 through Mesa's lima driver (OpenGL ES 2.0, EGL, GBM)
BR2_PACKAGE_MESA3D=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_LIMA=y
BR2_PACKAGE_MESA3D_GBM=y
BR2_PACKAGE_MESA3D_OPENGL_EGL=y
BR2_PACKAGE_MESA3D_OPENGL_ES=y
# WPE WebKit hands its frames over with EGL_WL_bind_wayland_display
BR2_PACKAGE_MESA3D_LEGACY_BIND_WAYLAND_DISPLAY=y
BR2_PACKAGE_TDLIB=y
BR2_PACKAGE_NOTO_EMOJI=y
# Web: engine with JavaScript and its fonts, built here but carried by the Web plugin
# app (apps/web, post-fakeroot.sh leaves it out of the image)
BR2_PACKAGE_WPEWEBKIT=y
# HTTPS for libsoup (GIO TLS module)
BR2_PACKAGE_GLIB_NETWORKING=y
BR2_PACKAGE_DEJAVU=y
# Sound: amixer to set up the codec, aplay to test it
BR2_PACKAGE_ALSA_UTILS=y
BR2_PACKAGE_ALSA_UTILS_AMIXER=y
BR2_PACKAGE_ALSA_UTILS_APLAY=y
# Modem: its power, reset and status lines through the GPIO character device (S30modem)
BR2_PACKAGE_GPIOD_TOOLS=y
