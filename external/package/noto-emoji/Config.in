config BR2_PACKAGE_NOTO_EMOJI
	bool "noto-emoji"
	help
	  Google's Noto color emoji as 64 x 64 PNG images, one per
	  emoji, in /usr/share/emoji/<code points in hex>.png
	  (from the emoji-datasource-google package), without
	  U+FE0F in the names and without the skin tones.

	  https://github.com/googlefonts/noto-emoji
