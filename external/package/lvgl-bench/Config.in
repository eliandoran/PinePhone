config BR2_PACKAGE_LVGL_BENCH
	bool "lvgl-bench"
	depends on BR2_PACKAGE_LVGL
	help
	  Runs the LVGL benchmark demo full screen on the DRM display,
	  with the FPS/CPU monitor on screen. Not started at boot:
	  /etc/init.d/lvgl-bench start (stop S90phone-ui first);
	  results go to /tmp/lvgl-bench.log.
