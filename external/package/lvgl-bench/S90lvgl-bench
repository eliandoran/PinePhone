#!/bin/sh
#
# Runs the LVGL benchmark (or another demo) on the display (development), with the
# CPU at full clock.
# Output in /tmp/lvgl-bench.log.
# Arguments for lvgl-bench go in ARGS, one per line: scene names to run only those,
# or --widgets for the widgets demo.
#

PIDFILE=/var/run/lvgl-bench.pid
ARGS=/var/lib/lvgl-bench/args

case "$1" in
start)
	# schedutil keeps lowering the clock while LVGL spreads short draw tasks over
	# 4 threads: Containers ran at 10 FPS instead of 48. One policy for all cores.
	echo performance > /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor
	# Mesa's shader cache defaults to $HOME/.cache, read-only here
	export MESA_SHADER_CACHE_DIR=/var/lib/mesa-shader-cache
	set --
	if [ -f "$ARGS" ]; then
		while IFS= read -r arg; do
			[ -n "$arg" ] && set -- "$@" "$arg"
		done < "$ARGS"
	fi
	start-stop-daemon -S -b -m -p "$PIDFILE" -x /bin/sh -- \
		-c 'exec /usr/bin/lvgl-bench "$@" > /tmp/lvgl-bench.log 2>&1' lvgl-bench "$@"
	;;
stop)
	start-stop-daemon -K -p "$PIDFILE" && rm -f "$PIDFILE"
	;;
restart)
	"$0" stop
	sleep 1
	"$0" start
	;;
*)
	echo "Usage: $0 {start|stop|restart}"
	exit 1
	;;
esac
