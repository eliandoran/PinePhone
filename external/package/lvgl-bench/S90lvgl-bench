#!/bin/sh
#
# Runs the LVGL benchmark on the display (development). Output in /tmp/lvgl-bench.log.
#

PIDFILE=/var/run/lvgl-bench.pid

case "$1" in
start)
	start-stop-daemon -S -b -m -p "$PIDFILE" -x /bin/sh -- \
		-c 'exec /usr/bin/lvgl-bench > /tmp/lvgl-bench.log 2>&1'
	;;
stop)
	start-stop-daemon -K -p "$PIDFILE" && rm -f "$PIDFILE"
	;;
restart)
	"$0" stop
	sleep 1
	"$0" start
	;;
*)
	echo "Usage: $0 {start|stop|restart}"
	exit 1
	;;
esac
