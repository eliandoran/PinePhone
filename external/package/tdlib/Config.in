config BR2_PACKAGE_TDLIB
	bool "tdlib"
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_TOOLCHAIN_HAS_THREADS
	select BR2_PACKAGE_OPENSSL
	select BR2_PACKAGE_ZLIB
	help
	  Telegram Database Library, the client library for Telegram.
	  Only the JSON interface (libtdjson), in staging: the Telegram
	  plugin app (apps/telegram) carries it, the image does not.

	  https://core.telegram.org/tdlib
