# phone-ui's build, run in the build directory (the copy of src/): abi.h and
# i18n_languages.c and words.c generated there, then each source compiled on its own into obj/, which
# the copy keeps, in parallel, and again only when it, a header it includes or the flags
# changed. The link always runs (0.1 s): it then follows the libraries without listing them.
#
# phone-ui.mk runs it with Buildroot's compilers, flags and paths: CC, CXX, CFLAGS,
# CXXFLAGS, LDFLAGS, LIBS, STAGING (staging directory), PYTHON (host python3) and PKGDIR
# (this directory). They are saved in obj/buildroot.mk, which `just ui` builds with, without
# Buildroot (its 4 s of reading every package) while newer than phone-ui.mk and .config.

MAKEFLAGS += -r

BUILDROOT_VARS := CC CXX CFLAGS CXXFLAGS LDFLAGS LIBS STAGING PYTHON PKGDIR
ifdef STAGING
$(shell mkdir -p obj)
$(file >obj/buildroot.mk,# Saved by Makefile.build when Buildroot last built phone-ui)
$(foreach v,$(BUILDROOT_VARS),$(file >>obj/buildroot.mk,$(v) := $($(v))))
else
include obj/buildroot.mk
endif

# Every source in the tree, its folders included (obj/ is the objects')
SRCS := $(sort $(patsubst ./%,%,$(shell find . -path ./obj -prune -o -name '*.c' -print)) i18n_languages.c words.c)
CXXSRCS := $(patsubst ./%,%,$(shell find . -path ./obj -prune -o -name '*.cpp' -print))
OBJS := $(SRCS:%.c=obj/%.o) $(CXXSRCS:%.cpp=obj/%.o)

# Includes from the tree's root ("modem/modem.h"), then LVGL's
LVGL := -I$(CURDIR) -DLV_CONF_INCLUDE_SIMPLE -I$(STAGING)/usr/include/lvgl
# The tests' Makefile and the apps' warn the same
WARNINGS := -Wall -Wshadow -Wvla -Wimplicit-fallthrough
ALL_CFLAGS := $(CFLAGS) -O2 $(WARNINGS) -Wstrict-prototypes -Wmissing-prototypes $(LVGL) -I$(STAGING)/usr/include/libdrm \
	-I$(STAGING)/usr/include/dbus-1.0 -I$(STAGING)/usr/lib/dbus-1.0/include
# The browser's litehtml container is C++
ALL_CXXFLAGS := $(CXXFLAGS) -O2 $(WARNINGS) -std=c++17 -ffunction-sections -fdata-sections $(LVGL)

# Every object depends on obj/flags, rewritten when the flags differ from the last build's
FLAGS := $(strip $(CC) $(ALL_CFLAGS) | $(CXX) $(ALL_CXXFLAGS))
ifneq ($(file <obj/flags),$(FLAGS))
$(shell mkdir -p obj)
$(file >obj/flags,$(FLAGS))
endif

phone-ui: $(OBJS)
	@echo "  LD   phone-ui"
	@$(CC) $(CFLAGS) $(LDFLAGS) -O2 -Wall -rdynamic -Wl,--gc-sections -o $@ $(OBJS) \
		-Wl,--whole-archive -llvgl -Wl,--no-whole-archive $(LIBS)

# The generated files are rewritten only when they change, or what includes them would
# compile again; then older than what they come from, they are made again each time (ms).
# UI_ABI: a fingerprint of each declaration of the headers plugin apps are built against,
# and one of LVGL's headers, each of which a plugin's must still match (gen-abi.py)
abi.h: $(PKGDIR)/gen-abi.py ui.h json.h i18n.h $(shell find $(STAGING)/usr/include/lvgl -name '*.h' | LC_ALL=C sort)
	@$(PYTHON) $(PKGDIR)/gen-abi.py $@ $(STAGING)/usr/include/lvgl ui.h json.h i18n.h

# The translations: po/'s catalogs in C
i18n_languages.c: $(PKGDIR)/gen-translations.py $(wildcard $(PKGDIR)/po/*.po)
	@$(PYTHON) $(PKGDIR)/gen-translations.py $(PKGDIR)/po $@

# The keyboard's dictionaries: words/' lists in C
words.c: $(PKGDIR)/gen-words.py $(wildcard $(PKGDIR)/words/*.txt)
	@$(PYTHON) $(PKGDIR)/gen-words.py $(PKGDIR)/words $@

$(OBJS): | abi.h

obj/%.o: %.c obj/flags
	@mkdir -p $(@D)
	@echo "  CC   $<"
	@$(CC) $(ALL_CFLAGS) -MMD -MP -c $< -o $@

obj/%.o: %.cpp obj/flags
	@mkdir -p $(@D)
	@echo "  CXX  $<"
	@$(CXX) $(ALL_CXXFLAGS) -MMD -MP -c $< -o $@

-include $(OBJS:.o=.d)

.PHONY: phone-ui
