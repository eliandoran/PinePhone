/* What the tests' programs export to plugin apps besides phone-ui's own (exports.list,
 * gen-abi.py): the fakes the plugins and their libraries call in the program (ld
 * --dynamic-list, the Makefile's EXPORTS) */
{
	__wrap_*;	/* PLUGIN_WRAPS: their time() */
	fake_*;		/* fake_td_*() for libtdjson.so, fake_doom and fake_genesis for the engines */
	webkit_*;	/* fake_webkit.c, Browser's engine */
	wpe_*;
	jsc_*;
	curl_*;		/* fake_curl.c, for plugins with requests of their own (Trilium's sync) */
};
