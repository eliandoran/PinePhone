#!/bin/sh
#
# Starts the phone user interface on the display.
# Output in $LOG/phone-ui.log (the data partition: kept across reboots), linked from
# /tmp/phone-ui.log; each start moves the earlier ones along, phone-ui.log.1 the last
# run's, up to $KEEP of them (about 0.25 MB a day; one bigger than $MAX keeps its end).
# Without a writable /var/lib, in /tmp only.
#
# Development builds (`just ui` on the host) go to $DEV and run instead of
# /usr/bin/phone-ui while the installed binary is the one they were pushed over
# (its SHA-256 in $DEV/base): flashing a new image retires them. If one exits
# with an error, the installed binary takes over.
#
# Arguments after start or restart go to phone-ui (`restart --open GitHub`, as
# `just app` does); without any, a development build takes the ones it was
# pushed with ($DEV/args).
#

PIDFILE=/var/run/phone-ui.pid
DEV=/var/lib/phone-ui/dev
LOG=/var/lib/phone-ui/log
KEEP=5
MAX=2097152

# The earlier runs' logs moved along, the oldest dropped; /tmp/phone-ui.log to the new one
rotate() {
	if ! mkdir -p "$LOG" 2>/dev/null || ! touch "$LOG/.writable" 2>/dev/null; then
		LOG=/tmp
		rm -f /tmp/phone-ui.log
		return
	fi
	rm -f "$LOG/.writable"
	n=$KEEP
	while [ $n -gt 1 ]; do
		[ -f "$LOG/phone-ui.log.$((n - 1))" ] && mv "$LOG/phone-ui.log.$((n - 1))" "$LOG/phone-ui.log.$n"
		n=$((n - 1))
	done
	if [ -f "$LOG/phone-ui.log" ]; then
		if [ "$(wc -c < "$LOG/phone-ui.log")" -gt $MAX ]; then
			tail -c $MAX "$LOG/phone-ui.log" > "$LOG/phone-ui.log.1"
			rm -f "$LOG/phone-ui.log"
		else
			mv "$LOG/phone-ui.log" "$LOG/phone-ui.log.1"
		fi
	fi
	ln -sfn "$LOG/phone-ui.log" /tmp/phone-ui.log
}

run() {
	if [ -x "$DEV/phone-ui" ] && [ -f "$DEV/base" ] &&
	   [ "$(sha256sum /usr/bin/phone-ui | cut -d' ' -f1)" = "$(cat "$DEV/base")" ]; then
		echo "phone-ui: development build ($(cat "$DEV/info" 2>/dev/null))"
		if [ $# -eq 0 ]; then
			# shellcheck disable=SC2046 # one argument per word
			set -- $(cat "$DEV/args" 2>/dev/null)
		fi
		"$DEV/phone-ui" "$@" && exit 0
		echo "phone-ui: development build exited with $?, starting the installed one"
	fi
	exec /usr/bin/phone-ui "$@"
}

case "$1" in
start)
	# The GPU driver is a module, which S10mdev's coldplug (in the background) may
	# not have loaded yet: without it Mesa falls back to software rendering
	modprobe -q lima
	# Mesa's shader cache defaults to $HOME/.cache, read-only here
	export MESA_SHADER_CACHE_DIR=/var/lib/mesa-shader-cache
	shift
	rotate
	# The time it started: the clock may still be wrong this early in a boot
	echo "phone-ui: log of $(date '+%Y-%m-%d %H:%M:%S %Z'), $(cut -d' ' -f1 /proc/uptime) s after boot" \
		> "$LOG/phone-ui.log"
	export LOG
	# shellcheck disable=SC2016 # expanded by that shell
	start-stop-daemon -S -b -m -p "$PIDFILE" -x /bin/sh -- \
		-c 'exec /etc/init.d/S90phone-ui run "$@" >> "$LOG/phone-ui.log" 2>&1' sh "$@"
	;;
run)
	shift
	run "$@"
	;;
stop)
	# The pid file has the shell running a development build (killed first,
	# so that it does not fall back), or the installed phone-ui
	start-stop-daemon -K -p "$PIDFILE" -q
	killall -q phone-ui
	rm -f "$PIDFILE"
	# phone-ui pins the CPU's frequency (cpu.c): its whole range again for what runs next
	c=/sys/devices/system/cpu/cpufreq/policy0
	cat $c/cpuinfo_max_freq > $c/scaling_max_freq 2>/dev/null
	cat $c/cpuinfo_min_freq > $c/scaling_min_freq 2>/dev/null
	;;
restart)
	"$0" stop
	sleep 1
	shift
	"$0" start "$@"
	;;
*)
	echo "Usage: $0 {start|stop|restart} [phone-ui arguments]"
	exit 1
	;;
esac
