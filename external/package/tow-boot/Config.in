config BR2_PACKAGE_TOW_BOOT
	bool "tow-boot"
	depends on BR2_aarch64
	help
	  Tow-Boot for the PinePhone (A64), the release's build, for the
	  microSD card image (pinephone-sd.img): written at 8 KiB, where
	  the boot ROM looks on the card. The eMMC's image has none: there
	  Tow-Boot is installed in boot0 by its own installer.

	  https://tow-boot.org/devices/pine64-pinephoneA64.html
