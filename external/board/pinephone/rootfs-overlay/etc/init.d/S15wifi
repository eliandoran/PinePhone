#!/bin/sh
#
# wpa_supplicant on the RTL8723CS (wlan0). Networks are kept in
# /var/lib/wpa_supplicant/wpa_supplicant.conf (data partition), which phone-ui
# and wpa_cli change through the control socket in /run/wpa_supplicant
# (update_config=1 writes them back). wpa_cli runs wpa_action.sh as it connects
# and disconnects: the address by DHCP.
#

CONF=/var/lib/wpa_supplicant/wpa_supplicant.conf

case "$1" in
	start)
		echo -n "Starting wpa_supplicant... "
		if [ ! -f "$CONF" ]; then
			mkdir -p "${CONF%/*}"
			printf 'ctrl_interface=/run/wpa_supplicant\nupdate_config=1\n' > "$CONF"
			chmod 600 "$CONF"
		fi
		# mdev loads rtw88_8723cs in the background: wlan0 shows up about 5 s after boot.
		# Waited for in the background too, the boot going on (phone-ui asks wpa_supplicant
		# again each second until it answers)
		(
			i=0
			while [ ! -d /sys/class/net/wlan0 ] && [ $i -lt 100 ]; do
				sleep 0.1
				i=$((i + 1))
			done
			wpa_supplicant -B -i wlan0 -D nl80211 -c "$CONF" &&
				wpa_cli -B -i wlan0 -a /etc/wpa_action.sh ||
				echo "<3>wifi: wpa_supplicant did not start" > /dev/kmsg
			# Turned off in phone-ui: down before it connects (phone-ui does it too)
			grep -qx "wifi=0" /var/lib/phone-ui/settings 2>/dev/null && ip link set wlan0 down
		) </dev/null >/dev/null 2>&1 &
		echo "OK"
		;;
	stop)
		echo -n "Stopping wpa_supplicant... "
		killall wpa_cli wpa_supplicant 2>/dev/null
		echo "OK"
		;;
	restart|reload) "$0" stop; "$0" start ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
