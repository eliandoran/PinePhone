#!/bin/sh
#
# USB gadget on the Type-C port: serial console (ACM, /dev/ttyACM0 on the host)
# and a network interface (NCM, phone is 172.16.42.1), with the host as default
# route and public DNS servers.
#

GADGET=/sys/kernel/config/usb_gadget/pinephone

start() {
	echo -n "Starting USB gadget... "
	grep -q " /sys/kernel/config " /proc/mounts || mount -t configfs none /sys/kernel/config
	mkdir -p "$GADGET" && cd "$GADGET" || return 1

	echo 0x1d6b > idVendor   # Linux Foundation
	echo 0x0104 > idProduct  # Multifunction Composite Gadget
	mkdir -p strings/0x409
	echo "Pine64" > strings/0x409/manufacturer
	echo "PinePhone (Buildroot)" > strings/0x409/product
	cat /proc/sys/kernel/random/boot_id > strings/0x409/serialnumber

	mkdir -p functions/acm.usb0 functions/ncm.usb0
	# Fixed MACs so the host sees the same interface on every boot
	echo 02:50:48:00:00:01 > functions/ncm.usb0/dev_addr
	echo 02:50:48:00:00:02 > functions/ncm.usb0/host_addr
	mkdir -p configs/c.1/strings/0x409
	echo "ACM + NCM" > configs/c.1/strings/0x409/configuration
	ln -sf "$GADGET/functions/acm.usb0" configs/c.1/
	ln -sf "$GADGET/functions/ncm.usb0" configs/c.1/

	udc=$(ls /sys/class/udc | head -n1)
	echo "$udc" > UDC
	ifconfig usb0 172.16.42.1 netmask 255.255.255.0 up && udhcpd /etc/udhcpd.conf
	[ $? -eq 0 ] && echo "OK" || echo "ERROR"
	# Internet through the host, when it shares its connection (`just share-internet`)
	route add default gw 172.16.42.2 usb0
	printf 'nameserver 9.9.9.9\nnameserver 1.1.1.1\n' > /run/resolv.conf

	reconnect_until_configured "$udc" &
}

# The first connection to the host sometimes fails: the host starts
# enumerating, then the gadget drops to "not attached" and stays there.
# Reconnect a few times until a host configures it.
reconnect_until_configured() {
	for attempt in 1 2 3 4 5; do
		sleep 10
		state=$(cat "/sys/class/udc/$1/state")
		if [ "$state" = configured ]; then
			[ "$attempt" -gt 1 ] && echo "usbgadget: configured after $((attempt - 1)) reconnect(s)" > /dev/kmsg
			return 0
		fi
		echo "usbgadget: $state after $((attempt * 10)) s, reconnecting" > /dev/kmsg
		echo "" > "$GADGET/UDC"
		sleep 1
		echo "$1" > "$GADGET/UDC"
	done
	echo "usbgadget: giving up, still $(cat "/sys/class/udc/$1/state")" > /dev/kmsg
}

stop() {
	echo -n "Stopping USB gadget... "
	killall udhcpd 2>/dev/null
	echo "" > "$GADGET/UDC" 2>/dev/null
	echo "OK"
}

case "$1" in
	start|stop) "$1" ;;
	restart|reload) stop; start ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
