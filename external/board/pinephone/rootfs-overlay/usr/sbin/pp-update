#!/bin/sh
#
# A/B slot management. Slot A is partition 1, slot B is partition 2 (see
# genimage.cfg); the bootloader boots the partition with the bootable flag.
# Partition 3 is the data partition (see S00data). The disk is the one the
# system runs from: the eMMC (disk signature 50480001) or a microSD card
# (50480002), the partitions known by that signature and their number.
#
# Usage:
#   pp-update SIZE SHA256 < rootfs.ext4   install into the inactive slot, on trial
#   pp-update set-boot N                  boot slot N next
#   pp-update current                     print the running slot
#   pp-update emmc                        print the disk's device name (mmcblkN)
#
# A freshly installed slot boots on trial: S98pp-trial confirms it once phone-ui
# shows its home screen, or moves the bootable flag back to the previous slot.

set -e

# On the data partition: "SLOT PREVIOUS_SLOT" while a slot is on trial.
TRIAL=/var/lib/pp-update/trial

current_slot() {
	sed -n 's/.*root=PARTUUID=5048000[12]-0\([12]\).*/\1/p' /proc/cmdline
}

# The running disk's signature, as its partitions' IDs start
signature() {
	sed -n 's/.*root=PARTUUID=\(5048000[12]\)-0[12].*/\1/p' /proc/cmdline
}

# The disk the system runs from (the eMMC or the microSD card), found from the
# device the root filesystem is mounted from.
emmc() {
	majmin=$(awk '$5 == "/" { print $3; exit }' /proc/self/mountinfo)
	rootpart=$(basename "$(readlink -f "/sys/dev/block/$majmin")")
	echo "${rootpart%p[0-9]*}"
}

# Set the bootable flag on slot $1 only, with a single sector write.
set_boot() {
	disk=$(emmc)
	dd if="/dev/$disk" of=/tmp/mbr bs=512 count=1 2>/dev/null
	for p in 1 2; do
		if [ "$p" -eq "$1" ]; then printf '\200'; else printf '\000'; fi |
			dd of=/tmp/mbr bs=1 seek=$((446 + 16 * (p - 1))) conv=notrunc 2>/dev/null
	done
	# conv=fsync flushes the eMMC write cache: sync alone does not for raw
	# block devices, and the write is lost on a hard power-off.
	dd if=/tmp/mbr of="/dev/$disk" bs=512 count=1 conv=fsync 2>/dev/null
	sync
}

install() {
	size=$1
	sha=$2

	cur=$(current_slot)
	if [ -z "$cur" ]; then
		echo "Cannot determine the running slot from /proc/cmdline" >&2
		exit 1
	fi
	new=$((3 - cur))
	disk=$(emmc)
	target=/dev/${disk}p${new}

	# The CPU at its highest for gunzip and SHA-256 (phone-ui pins its lowest, cpu.c),
	# its limits as they were when this ends (failed, or the restart)
	c=/sys/devices/system/cpu/cpufreq/policy0
	if [ -f "$c/cpuinfo_max_freq" ]; then
		min=$(cat "$c/scaling_min_freq") max=$(cat "$c/scaling_max_freq")
		trap 'echo "$max" > "$c/scaling_max_freq"; echo "$min" > "$c/scaling_min_freq"; echo "$max" > "$c/scaling_max_freq"' EXIT
		cat "$c/cpuinfo_max_freq" > "$c/scaling_max_freq"
		cat "$c/cpuinfo_max_freq" > "$c/scaling_min_freq"
	fi

	capacity=$(( $(cat "/sys/class/block/${disk}p${new}/size") * 512 ))
	if [ "$size" -gt "$capacity" ]; then
		echo "Image ($size bytes) does not fit in $target ($capacity bytes)" >&2
		exit 1
	fi

	echo "Running slot $cur, writing slot $new ($target)"
	dd of="$target" bs=1M conv=fsync 2>/dev/null
	sync
	echo 3 > /proc/sys/vm/drop_caches

	got=$(head -c "$size" "$target" | sha256sum | cut -d' ' -f1)
	if [ "$got" != "$sha" ]; then
		echo "Checksum mismatch on $target, keeping slot $cur" >&2
		exit 1
	fi

	# The same image is used for both slots and both disks: point it at its own
	# partition, by this disk's signature (the eMMC's image installed on a card).
	sig=$(signature)
	mnt=/tmp/pp-update-mnt
	mkdir -p "$mnt"
	mount -t ext4 "$target" "$mnt"
	sed -i "s/root=PARTUUID=5048000[12]-0[12]/root=PARTUUID=$sig-0$new/" \
		"$mnt/boot/extlinux/extlinux.conf"
	umount "$mnt"

	if grep -q " /data " /proc/mounts; then
		mkdir -p "${TRIAL%/*}"
		echo "$new $cur" > "$TRIAL"
		rm -f "$TRIAL.boots"
		sync
		trial=" (on trial, falls back to slot $cur)"
	else
		trial=" (no data partition yet: no trial, no automatic rollback)"
	fi

	set_boot "$new"
	echo "Slot $new will boot next$trial, rebooting"
	(sleep 1; reboot) >/dev/null 2>&1 &
}

case "$1" in
	set-boot)
		case "$2" in
			1|2) set_boot "$2" ;;
			*) echo "Usage: $0 set-boot 1|2" >&2; exit 1 ;;
		esac
		;;
	current) current_slot ;;
	emmc) emmc ;;
	[0-9]*)
		[ -n "$2" ] || { echo "Usage: $0 SIZE SHA256 < rootfs.ext4" >&2; exit 1; }
		install "$1" "$2"
		;;
	*)
		echo "Usage: $0 SIZE SHA256 < rootfs.ext4 | set-boot 1|2 | current | emmc" >&2
		exit 1
		;;
esac
