# PinePhone-only drivers, applied on top of board/pinephone/linux.defconfig (generated from
# arm64 defconfig with localmodconfig, see CLAUDE.md). Everything needed to reach a shell on the
# display and over USB is built in; the rest stays modular and is loaded by mdev.

# PMIC and storage
CONFIG_SUNXI_RSB=y
CONFIG_MFD_AXP20X_RSB=y
CONFIG_REGULATOR_AXP20X=y
CONFIG_MMC_SUNXI=y

# Display: DE2 mixer -> TCON -> MIPI DSI -> ST7703 (XBD599) panel
CONFIG_DRM=y
CONFIG_DRM_SUN4I=y
CONFIG_DRM_SUN6I_DSI=y
CONFIG_DRM_SUN8I_MIXER=y
CONFIG_PHY_SUN6I_MIPI_DPHY=y
CONFIG_DRM_PANEL_SITRONIX_ST7703=y
CONFIG_PWM_SUN4I=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_PWM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
# HDMI (mixer1 -> TCON1 -> DW-HDMI) to the ANX7688: DisplayPort over USB-C. Built in, as the
# display's components bind together: a module would hold the panel until it loaded
CONFIG_DRM_SUN8I_DW_HDMI=y
CONFIG_DRM_DISPLAY_CONNECTOR=y

# Input: touchscreen, volume keys, power key
CONFIG_TOUCHSCREEN_GOODIX=y
CONFIG_KEYBOARD_SUN4I_LRADC=y
CONFIG_INPUT_AXP20X_PEK=y
# Bluetooth headphones' and speakers' buttons (AVRCP): bluetoothd makes them a key device
CONFIG_INPUT_UINPUT=y

# USB gadget on the Type-C port (serial console + network to the host)
CONFIG_USB_MUSB_HDRC=y
CONFIG_USB_MUSB_SUNXI=y
CONFIG_PHY_SUN4I_USB=y
CONFIG_USB_GADGET=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_NCM=y

# Battery and charger (AXP803)
CONFIG_AXP20X_ADC=y
# axp20x_usb_power with BC1.2 detection off (x-powers,no-bc-detection, our patch):
# detection on a connected host stops the gadget's network sending (tested) and
# sets a 500 mA input limit that the AXP803 keeps across restarts. The ANX7688
# driver needs this power supply (vbus_in-supply).
CONFIG_AXP20X_POWER=y
CONFIG_BATTERY_AXP20X=y

# USB-C: the ANX7688 bridge (Megi's driver), handles CC so a host supplies VBUS
CONFIG_TYPEC=y
CONFIG_TYPEC_ANX7688=y

# Vibrator, notification LED, camera flash
CONFIG_INPUT_GPIO_VIBRA=m
CONFIG_LEDS_CLASS_MULTICOLOR=y
CONFIG_LEDS_GROUP_MULTICOLOR=m
CONFIG_LEDS_CLASS_FLASH=m
CONFIG_LEDS_SGM3140=m

# Rear camera: OV5640 on the CSI parallel bus (V4L2, media controller)
CONFIG_MEDIA_SUPPORT=y
CONFIG_MEDIA_SUPPORT_FILTER=y
CONFIG_MEDIA_CAMERA_SUPPORT=y
CONFIG_MEDIA_PLATFORM_SUPPORT=y
CONFIG_VIDEO_DEV=y
CONFIG_MEDIA_PLATFORM_DRIVERS=y
CONFIG_V4L_PLATFORM_DRIVERS=y
CONFIG_VIDEO_SUN6I_CSI=m
CONFIG_VIDEO_CAMERA_SENSOR=y
CONFIG_VIDEO_OV5640=m
# Front camera: GC2145 on the same bus
CONFIG_VIDEO_GC2145=m
# their control bus: GPIO I2C on the CSI pins
CONFIG_I2C_GPIO=m
# Contiguous memory: neither the CSI nor the display engine has an IOMMU. The
# default 32 MB has ~9 MB left beside the display buffers, fragmented, and four
# 1600x1200 frames take 15 MB. Unused, it still holds movable pages.
CONFIG_CMA_SIZE_MBYTES=128

# Sensors: light/proximity, accelerometer/gyro, magnetometers
CONFIG_STK3310=m
CONFIG_INV_MPU6050_I2C=m
CONFIG_AF8133J=m
CONFIG_IIO_ST_MAGN_3AXIS=m

# Modem (Quectel EG25-G on USB): AT ports, QMI/MBIM data
CONFIG_USB_SERIAL=m
CONFIG_USB_SERIAL_OPTION=m
CONFIG_USB_WDM=m
CONFIG_USB_USBNET=m
CONFIG_USB_NET_QMI_WWAN=m
CONFIG_USB_NET_CDC_MBIM=m

# Wi-Fi and Bluetooth (RTL8723CS)
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_RTW88=m
CONFIG_RTW88_8723CS=m
CONFIG_BT=m
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_SERDEV=y
CONFIG_BT_HCIUART_RTL=y
# RFCOMM: the Hands-Free profile's commands (bluez-alsa's HFP gateway, calls on a headset)
CONFIG_BT_RFCOMM=m
# Game controllers: bluetoothd's input plugin makes them HID devices through /dev/uhid
# (UserspaceHID, BlueZ's default: no HIDP), built in so that the node exists for mdev.
# The PlayStation driver: DualShock 4 and DualSense, and an 8BitDo M30 (it poses as a DS4)
CONFIG_UHID=y
CONFIG_HID_PLAYSTATION=y

# Audio (codec, I2S, modem and Bluetooth PCM)
CONFIG_SND_SUN50I_CODEC_ANALOG=m
CONFIG_SND_SUN8I_CODEC=m
CONFIG_SND_SUN4I_I2S=m
CONFIG_SND_SOC_SIMPLE_AMPLIFIER=m
CONFIG_SND_SOC_BT_SCO=m
CONFIG_SND_SOC_GTM601=m
CONFIG_SND_SIMPLE_CARD=m

# Watchdog, crypto engine, DMA
CONFIG_SUNXI_WATCHDOG=m
CONFIG_CRYPTO_DEV_SUN8I_CE=m
CONFIG_DMA_SUN6I=m

# Sleep: /sys/power/pm_wakeup_irq (what woke the phone, phone-ui logs it) and pm_test
CONFIG_PM_DEBUG=y
# Each device's power/async (resumed alongside the others rather than in turn)
CONFIG_PM_ADVANCED_DEBUG=y

# Crash logs without a serial cable: a panic's log and the console kept in RAM (ramoops,
# the region is in the device tree) for /sys/fs/pstore on the next boot. The detectors only
# warn unless kernel.softlockup_panic, hardlockup_panic or hung_task_panic is set (sysctl).
# Only a watchdog reset keeps the RAM (a kernel restart goes through Crust, which restarts
# the PMIC): keep kernel.panic at 0 and let /dev/watchdog, unfed, reset the phone.
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_HARDLOCKUP_DETECTOR=y
CONFIG_DETECT_HUNG_TASK=y
CONFIG_DEFAULT_HUNG_TASK_TIMEOUT=120

# Not on this phone: PCI, ACPI, virtualization, NUMA
# CONFIG_PCI is not set
# CONFIG_ACPI is not set
# CONFIG_VIRTUALIZATION is not set
# CONFIG_XEN is not set
# CONFIG_NUMA is not set
