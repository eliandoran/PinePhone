# Romanian translation of Trilium, a plugin app of phone-ui
#
msgid ""
msgstr ""
"Project-Id-Version: trilium\n"
"Language: ro\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"X-Language-Name: Română\n"
"Plural-Forms: nplurals=3; plural=(n==1 ? 0 : (n==0 || (n%100 > 0 && n%100 < 20)) ? 1 : 2);\n"

#: apply.c sync.c
msgid "The notes could not be saved on the phone."
msgstr "Notițele nu au putut fi salvate pe telefon."

#: apply.c
msgid "The server sent notes this app cannot store (a newer version of Trilium?)."
msgstr "Serverul a trimis notițe pe care această aplicație nu le poate salva (o versiune mai nouă de Trilium?)."

#: apply.c sync.c trilium.c
msgid "The server's answer could not be read."
msgstr "Răspunsul serverului nu a putut fi citit."

#: note.c
msgid "Protected notes cannot be opened yet"
msgstr "Notițele protejate nu pot fi deschise deocamdată"

#: note.c search.c sync.c tree.c trilium.c
msgid "The database cannot be opened"
msgstr "Baza de date nu poate fi deschisă"

#: note.c
msgid "The note cannot be read"
msgstr "Notița nu poate fi citită"

#: note.c
msgid "This kind of note cannot be shown yet"
msgstr "Acest tip de notiță nu poate fi afișat deocamdată"

#: note.c
msgid "This note is empty"
msgstr "Această notiță este goală"

#: search.c trilium.c
msgid "Jump to note"
msgstr "Sari la notiță"

#: search.c
msgid "No notes found"
msgstr "Nu s-a găsit nicio notiță"

#: search.c
msgid "Note title"
msgstr "Denumirea notiței"

#: setup.c sync.c
msgid "Cannot reach the server."
msgstr "Serverul nu poate fi contactat."

#: setup.c
msgid "Connect"
msgstr "Conectează"

#: setup.c
msgid "Enter the address of your Trilium server or sync relay, as in Trilium's sync options, and the password of your notes."
msgstr "Introduceți adresa serverului Trilium sau a releului de sincronizare, ca în opțiunile de sincronizare ale Trilium, și parola notițelor dumneavoastră."

#: setup.c
msgid "Enter the code from your authenticator app."
msgstr "Introduceți codul din aplicația de autentificare."

#: setup.c
msgid "Enter the server's address."
msgstr "Introduceți adresa serverului."

#: setup.c
msgid "No Trilium server at this address."
msgstr "Nu există un server Trilium la această adresă."

#: setup.c
msgid "Password"
msgstr "Parolă"

#: setup.c
msgid "Server address"
msgstr "Adresa serverului"

#: setup.c
msgid "Sync with Trilium"
msgstr "Sincronizare cu Trilium"

#: setup.c sync.c
#, c-format
msgid "The server answered with an error (%ld)."
msgstr "Serverul a răspuns cu o eroare (%ld)."

#: setup.c
#, c-format
msgid "The server runs another version of Trilium (sync version %lld, this app needs %d)."
msgstr "Serverul rulează altă versiune de Trilium (versiunea de sincronizare %lld, aplicația are nevoie de %d)."

#: setup.c
msgid "The server's answer could not be kept."
msgstr "Răspunsul serverului nu a putut fi salvat."

#: setup.c
msgid "There are no notes on this server yet: sync to it from Trilium on a computer first."
msgstr "Nu există încă notițe pe acest server: sincronizați-l mai întâi din Trilium, de pe un calculator."

#: setup.c
msgid "Too many attempts. Try again in a few minutes."
msgstr "Prea multe încercări. Reîncercați peste câteva minute."

#: setup.c
msgid "Two-factor code"
msgstr "Cod de autentificare în doi pași"

#: setup.c
msgid "Wait..."
msgstr "Așteptați..."

#: setup.c
msgid "Wrong password."
msgstr "Parolă greșită."

#: setup.c
msgid "Wrong two-factor code."
msgstr "Cod de autentificare în doi pași greșit."

#: sync.c
msgid "The notes on the phone and on the server still differ after syncing."
msgstr "Notițele de pe telefon și cele de pe server încă diferă după sincronizare."

#: sync.c
msgid "The phone's clock and the server's differ by more than 5 minutes."
msgstr "Ceasul telefonului și cel al serverului diferă cu mai mult de 5 minute."

#: sync.c
msgid "The server does not accept this phone's credentials for the document."
msgstr "Serverul nu acceptă datele de autentificare ale acestui telefon pentru document."

#: sync.c
msgid "The server runs another version of Trilium."
msgstr "Serverul rulează altă versiune de Trilium."

#: tree.c trilium.c
msgid "No notes yet"
msgstr "Nicio notiță deocamdată"

#: tree.c
msgid "Protected note"
msgstr "Notiță protejată"

#: tree.c
msgid "The notes cannot be read"
msgstr "Notițele nu pot fi citite"

#: trilium.c
#, c-format
msgid "%lld attachment"
msgid_plural "%lld attachments"
msgstr[0] "%lld atașament"
msgstr[1] "%lld atașamente"
msgstr[2] "%lld de atașamente"

#: trilium.c
#, c-format
msgid "%lld attribute"
msgid_plural "%lld attributes"
msgstr[0] "%lld atribut"
msgstr[1] "%lld atribute"
msgstr[2] "%lld de atribute"

#: trilium.c
#, c-format
msgid "%lld note"
msgid_plural "%lld notes"
msgstr[0] "%lld notiță"
msgstr[1] "%lld notițe"
msgstr[2] "%lld de notițe"

#: trilium.c
#, c-format
msgid "%lld revision"
msgid_plural "%lld revisions"
msgstr[0] "%lld revizie"
msgstr[1] "%lld revizii"
msgstr[2] "%lld de revizii"

#: trilium.c
msgid "Checking the notes"
msgstr "Verificarea notițelor"

#: trilium.c
msgid "Connecting to the server"
msgstr "Conectare la server"

#: trilium.c
#, c-format
msgid "Database %s, SQLite %s"
msgstr "Bază de date %s, SQLite %s"

#: trilium.c
msgid "Document"
msgstr "Document"

#: trilium.c
msgid "Sync failed"
msgstr "Sincronizarea a eșuat"

#: trilium.c
msgid "Sync in progress"
msgstr "Sincronizare în curs"

#: trilium.c
msgid "Syncing data"
msgstr "Sincronizarea datelor"

#: trilium.c
#, c-format
msgid "Syncs with %s"
msgstr "Se sincronizează cu %s"

#: trilium.c
msgid "The first sync copies all your notes to the phone. It goes on if you leave the app."
msgstr "Prima sincronizare copiază toate notițele dumneavoastră pe telefon. Continuă și dacă părăsiți aplicația."

#: trilium.c
msgid "Try again"
msgstr "Reîncearcă"

#: trilium.c
msgid "What was copied so far is kept: trying again goes on from there."
msgstr "Ce s-a copiat până acum se păstrează: o nouă încercare continuă de acolo."
